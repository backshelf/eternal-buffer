{
  "name": "eternal-buffer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun dev.ts",
    "build": "bun build ./index.html --outdir dist --production --sourcemap=linked",
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "tokens": "bun design/build-tokens.ts",
    "sim": "bun sim/run.ts",
    "verify": "bun run typecheck && bun run lint",
    "gates": "bun run typecheck && bun run lint && bun run build",
    "gates:full": "bun run gates && bun run sim -- --contract"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@number-flow/react": "0.6.2",
    "@replit/codemirror-vim": "^6.4.0",
    "break_eternity.js": "2.1.3",
    "canvas-confetti": "1.9.4",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "watchpot": "1.0.0-rc.13",
    "zustand": "5.0.16",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
